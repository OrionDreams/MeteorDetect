<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:MeteorDetect.App.Behaviors"
        xmlns:vm="clr-namespace:MeteorDetect.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="780"
        x:Class="MeteorDetect.App.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="MeteorDetect"
        Icon="/Assets/MeteorDetect.png"
        Width="1280"
        Height="780"
        MinWidth="900"
        MinHeight="620">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#090B10"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#111721"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#151B26"/>
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#1B2230"/>
        <SolidColorBrush x:Key="BorderBrushMuted" Color="#283141"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB4C1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#768395"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F08A24"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#C96717"/>
        <SolidColorBrush x:Key="MarkerBrush" Color="#F25CAA"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.tile.processed">
            <Setter Property="BorderBrush" Value="{StaticResource MarkerBrush}"/>
        </Style>
        <Style Selector="Border.tile.clipTile">
            <Setter Property="Padding" Value="14,10,14,8"/>
        </Style>
        <Style Selector="Border.selectionFrame">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="Border.selectionFrame.selected">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.statusBadge">
            <Setter Property="Background" Value="#202838"/>
        </Style>
        <Style Selector="Border.statusBadge.detecting">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusBadgeText">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusBadgeText.detecting">
            <Setter Property="Foreground" Value="#101217"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="{StaticResource PanelSoftBrush}"/>
            <Setter Property="BorderBrush" Value="#384354"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#222B39"/>
            <Setter Property="BorderBrush" Value="#4A5668"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#101217"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#FF9A37"/>
            <Setter Property="BorderBrush" Value="#FF9A37"/>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
        </Style>
        <Style Selector="Button.pausePending">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#101217"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource MarkerBrush}"/>
            <Setter Property="Background" Value="#202838"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0D121A"/>
            <Setter Property="BorderBrush" Value="#303A4B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="{StaticResource AppBackgroundBrush}">
        <Border Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.65">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#131823" Offset="0"/>
                    <GradientStop Color="#090B10" Offset="0.42"/>
                    <GradientStop Color="#140D17" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border Padding="22,14" Background="#121821">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#090B10" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="/Assets/MeteorDetect.png" Width="38" Height="38" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MeteorDetect" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AppVersionText}" Classes="muted"/>
                        <TextBlock Classes="secondary"
                                   Text="Detect source-frame meteors and prepare Resolve Pink clip markers."/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="36"
                            Height="36"
                            MinWidth="36"
                            MinHeight="36"
                            Padding="0"
                            CornerRadius="18"
                            Background="#291A2A"
                            BorderBrush="{StaticResource MarkerBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsUpdateAvailable}">
                        <Button.Flyout>
                            <Flyout>
                                <Button Content="{Binding UpdateNotificationText}"
                                        Command="{Binding OpenLatestReleaseCommand}"
                                        ToolTip.Tip="Click to open the download page in your browser"/>
                            </Flyout>
                        </Button.Flyout>
                        <Path Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Fill="{StaticResource MarkerBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M10 2C7.8 2 6 3.8 6 6V8.5C6 10.1 5.4 11.5 4.3 12.7L3.6 13.4C3.2 13.8 3.5 14.5 4 14.5H16C16.5 14.5 16.8 13.8 16.4 13.4L15.7 12.7C14.6 11.5 14 10.1 14 8.5V6C14 3.8 12.2 2 10 2ZM8 15.5C8.2 16.6 9 17.3 10 17.3C11 17.3 11.8 16.6 12 15.5H8Z"/>
                    </Button>
                    <Button Grid.Column="3" Content="Open File" Command="{Binding AddFilesCommand}" MinWidth="112"/>
                    <Button Grid.Column="4" Content="Open Directory" Command="{Binding OpenDirectoryCommand}" MinWidth="132"/>
                    <Button Grid.Column="5" Content="Refresh Directory" Command="{Binding RefreshDirectoryCommand}" MinWidth="142"/>
                    <Button Grid.Column="6" Classes.pausePending="{Binding IsPauseButtonPending}" Content="{Binding PauseButtonText}" Command="{Binding PauseDetectionCommand}" MinWidth="92"/>
                    <Button Grid.Column="7" Classes="primary" Content="{Binding DetectButtonText}" Command="{Binding DetectCommand}" MinWidth="132"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Camera Class" Classes="secondary" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding CameraClassOptions}"
                              SelectedItem="{Binding SelectedCameraClass, Mode=TwoWay}"
                              MinWidth="250"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="18">
            <TabItem Header="Files">
                <Grid Margin="18,0,0,0" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel>
                            <TextBlock Text="Source Clips" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Classes="secondary" Text="Batch detection runs through the Python detector and writes JSON for Resolve import."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <CheckBox Content="Ignore camera bumps"
                                      IsChecked="{Binding IgnoreCameraBumps}"
                                      ToolTip.Tip="Use this only if the camera was moved while recording."/>
                            <CheckBox Content="Output diagnostic images"
                                      IsChecked="{Binding OutputDiagnosticImages}"
                                      ToolTip.Tip="Write candidate frame JPEGs next to each source video."/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Classes="panel" Padding="10">
                        <ListBox ItemsSource="{Binding Clips}"
                                 SelectedItem="{Binding SelectedClip, Mode=TwoWay}"
                                 SelectionMode="Multiple"
                                 behaviors:ListBoxSelectionMirror.SelectedItems="{Binding SelectedClips}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClipItemViewModel">
                                    <Border Classes="selectionFrame" Classes.selected="{Binding IsSelected}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remove"
                                                          Command="{Binding #Root.DataContext.RemoveClipCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border Classes="tile clipTile" Classes.processed="{Binding HasProcessedDetection}">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                                <Grid ColumnDefinitions="*,70,100,100" ColumnSpacing="10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Path}" Classes="muted"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#161E2A" BorderBrush="#303A4B" BorderThickness="1" CornerRadius="999" Padding="8,5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Duration}" Classes="secondary" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Classes="statusBadge" Classes.detecting="{Binding IsDetectingStatus}" CornerRadius="999" Padding="8,5" VerticalAlignment="Center">
                                                        <TextBlock Classes="statusBadgeText" Classes.detecting="{Binding IsDetectingStatus}" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Column="3" Background="#291A2A" BorderBrush="#663653" BorderThickness="1" CornerRadius="999" Padding="8,5" VerticalAlignment="Center" IsVisible="{Binding IsEventBadgeVisible}">
                                                        <TextBlock Text="{Binding EventSummary}" Foreground="{StaticResource MarkerBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right"/>
                                                    </Border>
                                                </Grid>
                                                <Grid Grid.Row="1"
                                                      ColumnDefinitions="Auto,Auto,*"
                                                      ColumnSpacing="10"
                                                      IsVisible="{Binding HasPartialDetection}">
                                                    <TextBlock Text="{Binding PartialDetectionText}" Classes="secondary" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Content="Discard progress"
                                                            Command="{Binding #Root.DataContext.DiscardPartialCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Content="{Binding DeselectButtonText}" Command="{Binding DeselectSelectedCommand}"/>
                        <TextBlock Grid.Column="1" Text="{Binding OutputPath}" Classes="muted" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="3" Classes="panel" Padding="14">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Text="{Binding RemainingTimeText}" Classes="secondary" HorizontalAlignment="Right"/>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Grid.Row="2"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="3"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsDetecting}"/>
                            <TextBlock Grid.Row="3"
                                       Text="{Binding PauseCheckpointText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       IsVisible="{Binding IsPauseRequested}"/>
                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                <TextBlock Text="{Binding ProcessedFramesText}" Classes="muted"/>
                                <TextBlock Grid.Column="1" Text="{Binding FramesPerSecondText}" Classes="muted"/>
                                <TextBlock Grid.Column="2" Text="{Binding CandidateFramesText}" Classes="muted"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Expander Grid.Row="4" Header="Detector log" IsExpanded="False" HorizontalAlignment="Stretch">
                        <Border Classes="panel" Padding="10" HorizontalAlignment="Stretch">
                            <TextBox Text="{Binding LogText}"
                                     behaviors:LogAutoScroll.AutoScrollToEnd="True"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas,Menlo,Monospace"
                                     FontSize="12"
                                     Height="160"
                                     MinHeight="120"/>
                        </Border>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <Grid Margin="18,0,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <StackPanel>
                        <TextBlock Text="Processing History" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Classes="secondary" Text="Successful runs are recorded here independently from detector JSON output files."/>
                    </StackPanel>

                    <Border Grid.Row="1" Classes="panel" Padding="10">
                        <ListBox ItemsSource="{Binding HistoryEntries}" SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessingHistoryEntryViewModel">
                                    <Border Classes="tile">
                                        <Grid ColumnDefinitions="2.3*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ClipPath}" Classes="muted"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Duration}" Classes="secondary" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DetectorAlgorithm}" Classes="muted" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding VersionSummary}" Classes="muted" VerticalAlignment="Center"/>
                                            <Border Grid.Column="4" Background="#291A2A" BorderBrush="#663653" BorderThickness="1" CornerRadius="999" Padding="10,5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MeteorCount}" Foreground="{StaticResource MarkerBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Column="5" Text="{Binding DetectedAt}" Classes="muted" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                        <Button Content="Remove selected" Command="{Binding RemoveSelectedHistoryEntryCommand}"/>
                        <Button Grid.Column="1" Content="Clear history" Command="{Binding ClearHistoryCommand}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer Margin="18,0,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Classes="secondary" Text="Resolve importer location, output behavior and detector runtime."/>
                        </StackPanel>

                        <Border Grid.Row="1" Classes="tile">
                            <StackPanel Spacing="10">
                                <TextBlock Text="DaVinci Resolve Importer" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Install the Lua Utility script used by Resolve to import meteor JSON as Pink clip markers."
                                           Classes="secondary"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <TextBox Text="{Binding ResolveScriptDirectory, Mode=TwoWay}" PlaceholderText="Resolve Fusion/Scripts/Utility directory"/>
                                    <Button Grid.Column="1" Content="Choose directory" Command="{Binding BrowseResolveDirectoryCommand}"/>
                                    <Button Grid.Column="2" Classes="primary" Content="Install plugin" Command="{Binding InstallResolvePluginCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding ResolvePluginStatus}" Classes="secondary"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Classes="tile">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Detector" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Algorithm" Classes="secondary"/>
                                <ComboBox ItemsSource="{Binding DetectorAlgorithmOptions}"
                                          SelectedItem="{Binding SelectedDetectorAlgorithm, Mode=TwoWay}"
                                          MinWidth="360"/>
                                <TextBlock Text="{Binding SelectedDetectorAlgorithm.Description}"
                                           Classes="secondary"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Decoder" Classes="secondary" Margin="0,8,0,0"/>
                                <ComboBox ItemsSource="{Binding DetectorDecoderOptions}"
                                          SelectedItem="{Binding SelectedDetectorDecoder, Mode=TwoWay}"
                                          MinWidth="360"/>
                                <TextBlock Text="{Binding SelectedDetectorDecoder.Description}"
                                           Classes="secondary"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Diagnostic Level" Classes="secondary" Margin="0,8,0,0"/>
                                <ComboBox ItemsSource="{Binding DiagnosticLevelOptions}"
                                          SelectedItem="{Binding SelectedDiagnosticLevel, Mode=TwoWay}"
                                          MinWidth="360"/>
                                <TextBlock Text="{Binding SelectedDiagnosticLevel.Description}"
                                           Classes="secondary"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="14">
                            <Border Classes="tile">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Output" FontSize="18" FontWeight="SemiBold"/>
                                    <CheckBox Content="Write multiple clips into one JSON file"
                                              IsChecked="{Binding WriteCombinedJson}"/>
                                    <TextBlock Text="When off, each clip gets its own timestamped JSON next to the source video."
                                               Classes="secondary"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="tile">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Runtime" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding RuntimeStatus}" Classes="secondary"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
